# A cheaper silver-set judge, 2×H200 (or 8×H100 with TP 8): DeepSeek-V4-Flash,
# 284B MoE with 13B active, FP8 with FP4 experts (160 GB), served by vLLM
# (scripts/deploy.sh -b vllm). Recipe: recipes.vllm.ai/deepseek-ai/DeepSeek-V4-Flash.
# Weaker than judge-glm.env; check its agreement with the hand answers
# before trusting it.
HF_REPO=deepseek-ai/DeepSeek-V4-Flash
SERVED=deepseek-v4-flash
VLLM_ARGS="--tensor-parallel-size 2 --trust-remote-code --kv-cache-dtype fp8 --tokenizer-mode deepseek_v4 --max-model-len 65536 --max-num-seqs 64 --gpu-memory-utilization 0.92 --reasoning-parser deepseek_v4"
