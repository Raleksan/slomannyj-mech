# The silver-set judge, 8×H200 (141 GB each): GLM-5.3, 753B MoE with 40B
# active, native FP8 (756 GB), served by vLLM (scripts/deploy.sh -b vllm).
# vLLM's recipe: recipes.vllm.ai/zai-org/GLM-5.3. Label with
# BOOKGRAPH_MODEL=glm-5.3 bookgraph gold silver NAME -j 32.
HF_REPO=zai-org/GLM-5.3
SERVED=glm-5.3
VLLM_ARGS="--tensor-parallel-size 8 --kv-cache-dtype fp8 --max-model-len 65536 --max-num-seqs 64 --gpu-memory-utilization 0.92 --reasoning-parser glm45 --speculative-config.method mtp --speculative-config.num_speculative_tokens 5"
